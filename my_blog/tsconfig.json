{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "components/Common/Template": [
        "./astro/components/ReactFrame.tsx"
      ],
      "components/*": [
        "./src/components/*"
      ],
      "hooks/*": [
        "./src/hooks/*"
      ],
      "lib/*": [
        "./src/lib/*"
      ],
      "types/*": [
        "./src/types/*"
      ]
    },
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    ".astro/types.d.ts",
    "astro/**/*",
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "public"
  ]
}
