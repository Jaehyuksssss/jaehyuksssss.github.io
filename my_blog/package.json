{
  "name": "jaehyuk-engineering-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "임재혁 Engineering Notes — 기술 블로그",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "dev:stop": "node scripts/astro.mjs dev stop",
    "develop": "npm run dev",
    "start": "npm run dev",
    "build": "node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "serve": "npm run preview",
    "check": "node scripts/astro.mjs check && npm run typecheck",
    "typecheck": "node scripts/node.mjs node_modules/typescript/bin/tsc --noEmit",
    "test": "node scripts/node.mjs --test scripts/migration.test.mjs scripts/runtime.test.mjs",
    "test:build": "node scripts/node.mjs scripts/verify-build.mjs",
    "test:snapshot": "node scripts/node.mjs scripts/verify-migration-snapshot.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/markdown-remark": "7.3.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@supabase/supabase-js": "2.57.4",
    "astro": "7.3.8",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "~5.9.3",
    "cheerio": "1.1.2"
  },
  "license": "0BSD"
}
