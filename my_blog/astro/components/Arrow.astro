---
interface Props { size?: number; direction?: 'up-right' | 'right' }
const { size = 20, direction = 'right' } = Astro.props
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {direction === 'up-right' ? <path d="M6 18 18 6M6 6h12v12" /> : <path d="M4 12h16m-6-6 6 6-6 6" />}
</svg>
