  <div class="game-shell"><div class="breadcrumb"><a href="/games/">Playground</a><span>/</span><span>테트리스</span></div>
    <Tetris client:load />
    <GameLike slug="tetris" name="테트리스" client:visible />
    <noscript><p>게임을 플레이하려면 브라우저에서 JavaScript를 활성화해 주세요.</p></noscript>
  </div>
</SiteLayout>
