---
import { render, type CollectionEntry } from 'astro:content'
import SiteLayout from '../layouts/SiteLayout.astro'
import PostVisual from '../components/PostVisual.astro'
import PostActions from '../components/PostActions'
import CommentWidget from '../../src/components/Post/CommentWidget'
import AdSlot from '../components/AdSlot.astro'
import { allPosts, postPath, postHref, thumbnail, dateLabel, readingTime } from '../lib/posts'
import { site } from '../lib/site'

export async function getStaticPaths() {
  const posts = await allPosts()
  return posts.map((post, index) => ({ params: { slug: post.id }, props: { post, newer: posts[index - 1], older: posts[index + 1] } }))
}
interface Props { post: CollectionEntry<'posts'>; newer?: CollectionEntry<'posts'>; older?: CollectionEntry<'posts'> }
const { post, newer, older } = Astro.props
const { Content, headings } = await render(post)
const toc = headings.filter(heading => heading.depth <= 3)
const canonical = new URL(postHref(post), site.url).href
const schema = [{
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.data.title,
  description: post.data.summary, url: canonical, mainEntityOfPage: canonical,
  datePublished: post.data.date.toISOString(), dateModified: post.data.date.toISOString(),
  image: [new URL(thumbnail(post), site.url).href],
  author: { '@type': 'Person', name: site.author, url: site.url + '/about/' },
  publisher: { '@type': 'Organization', name: site.name }, keywords: post.data.categories.join(', '),
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: site.name, item: site.url },
    { '@type': 'ListItem', position: 2, name: post.data.title, item: canonical },
  ],
}]
---
<SiteLayout title={post.data.title} description={post.data.summary} image={thumbnail(post)} section="post" trackSlug={postPath(post)} structuredData={schema}>
  <meta slot="head" property="article:published_time" content={post.data.date.toISOString()} />
  <article class="article-container">
    <div class="breadcrumb"><a href="/">Writing</a><span>/</span><a href={'/articles/?category=' + encodeURIComponent(post.data.categories.find(c => c !== 'TIL') || 'All')}>{post.data.categories.find(c => c !== 'TIL') || 'Articles'}</a></div>
    <header class="article-header">
      <div class="tag-list">{post.data.categories.filter(c => c !== 'TIL').map(category => <a href={'/articles/?category=' + encodeURIComponent(category)}>{category}</a>)}</div>
      <h1>{post.data.title}</h1><p class="article-deck">{post.data.summary}</p>
      <div class="article-meta"><img src="/profile-image.png" alt="" width="30" height="30"/><span>{site.author}</span><span class="separator"></span><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span class="separator"></span><span>약 {readingTime(post)}분</span></div>
    </header>
    <div class="article-reading-grid">
      <div class="article-body"><PostVisual post={post} large eager /><div class="prose"><Content /></div>
        <AdSlot placement="article-mobile" />
        <PostActions slug={postPath(post)} client:visible />
        <section aria-labelledby="comments-heading"><h2 class="comments-heading" id="comments-heading">Comments<span class="accent-dot">.</span></h2><CommentWidget client:visible /></section>
        <nav class="post-navigation" aria-label="이전 글과 다음 글">
          {newer && <a href={postHref(newer)}><span>← 더 최근 글</span>{newer.data.title}</a>}
          {older && <a href={postHref(older)}><span>이전 글 →</span>{older.data.title}</a>}
        </nav>
      </div>
      <div class="article-side">{toc.length > 0 && <aside class="article-toc"><p>ON THIS PAGE</p><nav aria-label="목차">{toc.map(heading => <a href={'#' + heading.slug} data-depth={heading.depth}>{heading.text}</a>)}</nav></aside>}<AdSlot placement="article-rail" /></div>
    </div>
  </article>
</SiteLayout>
<script>
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach(pre => {
    const code = pre.querySelector('code')
    if (!code || !navigator.clipboard) return
    const button = document.createElement('button')
    button.type = 'button'; button.className = 'copy-code'; button.textContent = '복사'; button.setAttribute('aria-label', '코드 복사')
    button.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(code.textContent || ''); button.textContent = '복사됨' }
      catch { button.textContent = '복사 실패' }
      window.setTimeout(() => { button.textContent = '복사' }, 1800)
    })
    pre.prepend(button)
  })
</script>
