---
import SiteLayout from '../layouts/SiteLayout.astro'
import PostExplorer from '../components/PostExplorer.astro'
import Arrow from '../components/Arrow.astro'
import TotalViews from '../components/TotalViews'
import { allPosts } from '../lib/posts'
const posts = await allPosts()
---
<SiteLayout trackSlug="__home__">
  <div class="page-container">
    <section class="page-intro">
      <div><h1 class="page-title">DevOps<span> Notes</span><span class="title-period">.</span></h1><p class="intro-description">안녕하세요, 데브옵스 엔지니어 임재혁입니다.</p></div>
      <div class="intro-meta"><TotalViews client:load /><a class="author-link" href="/about/"><img src="/profile-image.png" alt="" width="40" height="40" /><span>임재혁<span>DevOps Engineer</span></span><Arrow size={17} direction="up-right" /></a></div>
    </section>
    <nav class="home-shortcuts" aria-label="도구 바로가기">
      <a href="/kubernetes-study/">
        <span><small>OPERATIONS LAB</small><strong>Kubernetes Lab</strong><span>장애 대응과 kubectl 런북</span></span>
        <Arrow size={19} direction="up-right" />
      </a>
      <a href="/games/">
        <span><small>PLAYGROUND</small><strong>Games</strong><span>브라우저에서 바로 플레이</span></span>
        <Arrow size={19} direction="up-right" />
      </a>
    </nav>
    <PostExplorer posts={posts} />
  </div>
</SiteLayout>
